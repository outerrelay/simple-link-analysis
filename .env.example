# --- Neo4j (the knowledge graph) ---------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

# --- Application state (charts, jobs, proposals, review queue) ---------
# SQLite locally; swap for a postgresql:// URL to go multi-user.
APP_DATABASE_URL=sqlite:///./data/app.sqlite

# --- Write policy ------------------------------------------------------
# Global default for transform results: "review" stages proposals until you
# accept them; "auto_commit" writes straight to Neo4j. Individual transforms
# may override this, and the context menu can override per invocation.
DEFAULT_WRITE_POLICY=review

# --- Credentials (not needed until later milestones) -------------------
ANTHROPIC_API_KEY=
COMPANIES_HOUSE_API_KEY=
